<?xml version="1.0" encoding="utf-8"?>
<org.schabi.newpipe.views.FocusAwareDrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.schabi.newpipe.views.FocusAwareCoordinator
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragment_holder"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            layout="@layout/toolbar_layout"
            android:id="@+id/toolbar_layout"/>

        <!-- Glassmorphism Status Bar Frost Scrim -->
        <View
            android:id="@+id/glass_status_bar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="?attr/glass_status_bar_drawable"
            android:elevation="6dp" />

        <!-- Glassmorphism Floating Bottom Dock -->
        <FrameLayout
            android:id="@+id/bottom_dock_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="?attr/glass_dock_drawable"
            android:elevation="12dp"
            android:padding="3dp">

            <org.schabi.newpipe.views.ScrollableTabLayout
                android:id="@+id/main_tab_layout"
                android:layout_width="220dp"
                android:layout_height="52dp"
                android:background="@android:color/transparent"
                app:tabGravity="fill"
                app:tabBackground="@drawable/bg_dock_tab_ripple"
                app:tabIndicator="?attr/glass_tab_indicator_drawable"
                app:tabIndicatorColor="@android:color/transparent"
                app:tabIndicatorAnimationMode="elastic"
                app:tabIndicatorGravity="center"
                app:tabIndicatorHeight="44dp"
                app:tabIndicatorFullWidth="false"
                app:tabMinWidth="60dp"
                app:tabMode="fixed"
                app:tabRippleColor="@android:color/transparent"
                app:tabTextAppearance="@style/BottomNavTabTextAppearance" />

        </FrameLayout>

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragment_player_holder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:elevation="20dp"
            app:behavior_hideable="true"
            app:behavior_peekHeight="0dp"
            app:layout_behavior="org.schabi.newpipe.player.gesture.CustomBottomSheetBehavior" />

        <!-- In-App Floating Mini Player (Inside App Only) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/in_app_floating_player"
            android:layout_width="210dp"
            android:layout_height="118dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="88dp"
            android:visibility="gone"
            app:cardCornerRadius="14dp"
            app:cardElevation="24dp"
            app:cardBackgroundColor="@android:color/black">

            <FrameLayout
                android:id="@+id/floating_player_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Invisible touch interceptor for drag and tap-to-expand -->
            <View
                android:id="@+id/floating_player_touch_target"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Controls Overlay (Close and Play/Pause) -->
            <RelativeLayout
                android:id="@+id/floating_player_controls"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="6dp"
                android:clickable="false">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/floating_player_close_button"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_floating_button"
                    android:src="@drawable/ic_close"
                    app:tint="@android:color/white"
                    android:contentDescription="@string/close" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/floating_player_play_pause_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_centerInParent="true"
                    android:background="@drawable/bg_floating_button"
                    android:src="@drawable/ic_pause"
                    app:tint="@android:color/white"
                    android:contentDescription="@string/play" />

            </RelativeLayout>

        </androidx.cardview.widget.CardView>

    </org.schabi.newpipe.views.FocusAwareCoordinator>

    <include
        layout="@layout/drawer_layout"
        android:id="@+id/drawer_layout" />

</org.schabi.newpipe.views.FocusAwareDrawerLayout>
